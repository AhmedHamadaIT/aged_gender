# ── Pipeline ─────────────────────────────────
# Comma-separated services to run on each frame, in order
# Available: detector, age_gender, mood, cashier
PIPELINE=detector,age_gender


# ── Detection model ──────────────────────────
YOLO_MODEL=./models/yolov8n.engine
CONF_THRESHOLD=0.35
FILTER_CLASSES=0
DEVICE=cuda:0

# ── Age & Gender model ────────────────────────
AGE_GENDER_MODEL=./models/best_aged_gender_6.onnx
AGE_GENDER_PADDING=10

# ── PPE model ────────────────────────
PPE_MODEL=./models/best_ppe.onnx
PPE_PADDING=10
PPE_CONF=0.25
PPE_IOU=0.45

# ── ReID model ───────────────────────────────
REID_MODEL=osnet_x1_0
REID_MODEL_PATH=./models/osnet_x1_0.pt
REID_MATCH_THRESHOLD=0.75
REID_AUTO_REGISTER=True
REID_VECTOR_SIZE=512
REID_PADDING=10
REID_COLLECTION=reid_gallery

# ── Qdrant (identity store) ─────────────────
QDRANT_URL=http://qdrant:6333


# ── Inference resolution ─────────────────────
WIDTH=320
HEIGHT=240

# ── Mood model ───────────────────────────────
MOOD_MODEL=./models/best_mood.onnx

# ── Phone detection model ─────────────────────
PHONE_MODEL=./models/best_phone.onnx
PHONE_PADDING=10
PHONE_CONF=0.25
PHONE_IOU=0.45

# ── Cashier Drawer monitor ────────────────────
CASHIER_MODEL=./models/best_cashier.onnx
CASHIER_CONFIG=./config/cashier_zones.yaml
CASHIER_EVIDENCE_DIR=./evidence/cashier
CASHIER_CAMERA_ID=cam
CASHIER_CONF_PERSON=0.50
CASHIER_CONF_DRAWER=0.45
CASHIER_CONF_CASH=0.50
CASHIER_DRAWER_MAX_SEC=30
CASHIER_WAIT_MAX_SEC=30
CASHIER_PROXIMITY_IOU=0.05
CASHIER_RELOAD_INTERVAL=60
CASHIER_LOG_MAX=5000

# ── Output ───────────────────────────────────
SAVE_OUTPUT=True
OUTPUT_DIR=./outputs
MAX_OUTPUT_FRAMES=

# ── Face Recognition ─────────────────────────
FACE_MODEL=buffalo_l
FACE_DET_SIZE=640
FACE_STORAGE_DIR=./data/face
FACE_DEVICE=0
DEVICE_SN=EDGE_DEVICE_001

TASK_QUEUE_COALESCE=true

# ── Real-time emergency profile (low-latency) ───────────────────────────────
# Keep only freshest frame in task workers.
TASK_QUEUE_MAXSIZE=8
TASK_QUEUE_COALESCE_THRESHOLD=0.5
TASK_QUEUE_INCLUDE_FRAME=false

# Make RTSP path favor low-latency; pair with camera sub-stream (channels/102).
RTSP_PROFILE=performance
RTSP_LOW_DELAY=true
RTSP_OPENCV_BUFFER_SIZE=1

# Keep preprocessing/inference load light for real-time annotation.
WIDTH=320
HEIGHT=240
FRAME_SKIP=2
STREAM_TARGET_FPS=3

# Force GPU decode/inference paths where available.
RTSP_ENABLE_GPU_DECODE=true
ML_REQUIRE_INFERENCE_GPU=1
ML_REQUIRE_ONNX_GPU=1
ONNX_EXECUTION_PROVIDERS_ORDER=cuda_first
ONNX_ALLOW_TENSORRT=0
LIVE_ANNOTATION_MODE=none
