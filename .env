# Vision Pipeline API — environment configuration
#
# This file is committed to git (no secrets).
# For local overrides with real credentials copy to .env.local (gitignored).
#
# ── YOLO / Inference ─────────────────────────────────────────────────────────
YOLO_MODEL=./models/yolov8n.pt
CONF_THRESHOLD=0.35
FILTER_CLASSES=0
# Inference device: cpu | cuda:0 | 0  (use cpu on machines without CUDA)
DEVICE=cpu

# ── Resolution ────────────────────────────────────────────────────────────────
WIDTH=640
HEIGHT=360

# ── Frame pipeline ────────────────────────────────────────────────────────────
FRAME_SKIP=1
STREAM_TARGET_FPS=0
TASK_QUEUE_MAXSIZE=8
TASK_QUEUE_COALESCE=true
TASK_QUEUE_COALESCE_THRESHOLD=0.5
TASK_QUEUE_INCLUDE_FRAME=false

# ── Annotation & live stream ──────────────────────────────────────────────────
# opencv (default, fast boxes) | ultralytics (richer plot) | none
LIVE_ANNOTATION_MODE=opencv
# Draw bounding boxes even without SAVE_OUTPUT / off-publish frames.
LIVE_PREVIEW_ANNOTATE=true
# FrameBus: set true to write every annotated frame to OUTPUT_DIR
SAVE_OUTPUT=false
SAVE_FORMAT=jpg
SAVE_JPEG_QUALITY=80
OUTPUT_DIR=./outputs
MAX_OUTPUT_FRAMES=

# ── JPEG quality ──────────────────────────────────────────────────────────────
# Task queue payloads (frame_b64 in worker messages)
TASK_QUEUE_JPEG_QUALITY=85
# Redis live-frame publishes
LIVE_JPEG_QUALITY=75

# ── Storage cleanup ───────────────────────────────────────────────────────────
OUTPUT_RETENTION_HOURS=24
STORAGE_CLEANUP_INTERVAL_SEC=3600

# ── State update throttle ─────────────────────────────────────────────────────
STATE_UPDATE_INTERVAL=10
STATE_UPDATE_MIN_SEC=1.0
PERF_LOG_INTERVAL=300
ANNOTATION_DEBUG_LOG_INTERVAL=1

# ── RTSP / stream ingest ──────────────────────────────────────────────────────
# Ingest order: auto | gstreamer | ffmpeg | opencv
RTSP_BACKEND=auto
# Try GStreamer + nvv4l2decoder on Jetson (requires OpenCV built with GStreamer)
RTSP_GSTREAMER=true
# Frame ingest backend: opencv (default) | pyav | av
# Set to "pyav" or "av" for PyAV-based ingest; requires: pip install av
STREAM_INGEST=opencv
# Default RTSP transport for OpenCV-FFmpeg: tcp | udp | udp_multicast
# Per-camera runtime override: utils.rtsp_ffmpeg.set_rtsp_transport(cam_id, transport)
RTSP_TRANSPORT=tcp
# Low-latency profile (pair with camera sub-stream for best results)
RTSP_PROFILE=balanced
RTSP_LOW_DELAY=false
RTSP_OPENCV_BUFFER_SIZE=3
RTSP_OPEN_TIMEOUT_MSEC=15000
RTSP_READ_TIMEOUT_MSEC=0
RTSP_MAX_CONSECUTIVE_READ_FAILS=10
STREAM_RECONNECT_BASE_SEC=2
STREAM_RECONNECT_MAX_SEC=30
RTSP_WARMUP_FRAMES=8
# Adaptive FFmpeg failover: fall back to OpenCV RTSP after this many reconnect cycles
RTSP_ADAPTIVE_FAILOVER_AFTER=4

# ── Jetson / hardware decode ──────────────────────────────────────────────────
RTSP_ENABLE_GPU_DECODE=auto
# RTSP_JETSON_HEVC_DECODER=hevc_nvmpi
# RTSP_JETSON_H264_DECODER=h264_nvmpi
# RTSP_HWDECODER=hevc_nvmpi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_RETRIES=3
REDIS_LIVE_FPS=13
# Reconnect delays for WebSocket Redis loop
WS_REDIS_RECONNECT_DELAY_MS=1000
WS_REDIS_MAX_RETRIES=5
WS_SEND_TIMEOUT_MS=50

# ── Qdrant (vector store for ReID / semantic search) ─────────────────────────
# Leave commented for Docker Compose: docker-compose.yml sets QDRANT_URL=http://qdrant:6333
# via `environment:`, which overrides this file. Uncomment only for non-Docker local dev,
# in which case http://127.0.0.1:6333 (or your tunneled host) is appropriate.
# QDRANT_URL=http://127.0.0.1:6333

# ── ReID ──────────────────────────────────────────────────────────────────────
REID_MODEL=osnet_x1_0
REID_MODEL_PATH=./models/osnet_x1_0.pt
REID_MATCH_THRESHOLD=0.75
REID_AUTO_REGISTER=true
REID_VECTOR_SIZE=512
REID_PADDING=10
REID_COLLECTION=reid_gallery

# ── PPE model ─────────────────────────────────────────────────────────────────
PPE_MODEL=./models/best_ppe.onnx
PPE_PADDING=10
PPE_CONF=0.25
PPE_IOU=0.45

# ── Phone detection ───────────────────────────────────────────────────────────
PHONE_MODEL=./models/best_phone.onnx
PHONE_PADDING=10
PHONE_CONF=0.25
PHONE_IOU=0.45

# ── Age & gender ──────────────────────────────────────────────────────────────
AGE_GENDER_MODEL=./models/best_aged_gender_6.onnx
AGE_GENDER_PADDING=10

# ── Mood ──────────────────────────────────────────────────────────────────────
MOOD_MODEL=./models/best_mood.onnx

# ── Cashier drawer monitor ────────────────────────────────────────────────────
CASHIER_MODEL=./models/best_cashier.onnx
CASHIER_CONFIG=./config/cashier_zones.yaml
CASHIER_EVIDENCE_DIR=./evidence/cashier
CASHIER_CAMERA_ID=cam
CASHIER_CONF_PERSON=0.50
CASHIER_CONF_DRAWER=0.45
CASHIER_CONF_CASH=0.50
CASHIER_DRAWER_MAX_SEC=30
CASHIER_WAIT_MAX_SEC=30
CASHIER_PROXIMITY_IOU=0.05
CASHIER_RELOAD_INTERVAL=60
CASHIER_LOG_MAX=5000

# ── Face recognition ──────────────────────────────────────────────────────────
FACE_MODEL=buffalo_l
FACE_DET_SIZE=640
FACE_STORAGE_DIR=./data/face
FACE_DEVICE=0

# ── ONNX Runtime ─────────────────────────────────────────────────────────────
ONNX_ALLOW_TENSORRT=1
ONNX_TENSORRT_CACHE_PATH=./trt_cache
ML_REQUIRE_INFERENCE_GPU=0
ML_REQUIRE_ONNX_GPU=0

# ── Worker process lifecycle ──────────────────────────────────────────────────
# Watchdog: auto-restart crashed FrameBus channels (off by default on edge)
WATCHDOG_ENABLED=false
WATCHDOG_RESPAWN_WINDOW_SEC=600
WATCHDOG_MAX_RESPAWNS=5
# Graceful drain timeout before worker join on stop
STOP_DRAIN_TIMEOUT_SEC=3

# ── Legacy pipeline (pipeline.py / batch scripts only) ───────────────────────
PIPELINE=detector,age_gender
DEVICE_SN=EDGE_DEVICE_001
