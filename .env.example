# Copy to `.env` for local overrides (`.env` is gitignored — do not commit secrets).
#
# ── GPU & ML inference (YOLO FrameBus, ReID TorchScript, Ultralytics) ───────
# Default DEVICE=0 uses the first CUDA GPU (same convention as Ultralytics).
# Use DEVICE=cpu on hosts without a GPU, or cuda:1 / 1 for a second card.
DEVICE=0
# YOLO_MODEL=yolov8n.pt          # PyTorch weights — or point to a TensorRT engine:
# YOLO_MODEL=models/best.engine  # TensorRT .engine file (Jetson / GPU — export with: yolo export model=... format=engine)
# CONF_THRESHOLD=0.45            # Lower slightly (e.g. 0.38–0.42) for more person recall in crowds
# IOU_THRESHOLD=0.55             # NMS IoU passed to model.track(); higher keeps more overlapping boxes (crowds)
# YOLO_MAX_DET=300               # Max boxes per frame (dense scenes)
# YOLO_IMGSZ=960                 # Optional fixed inference size (e.g. above stream WIDTH) for small / distant people
#
# Cross-line analytics (services/cross_line.py):
# CROSSLINE_ANCHOR_POINT=bottom  # bottom|center — bottom uses feet for line tests (default bottom)
# CROSSLINE_SIDE_STATE_TTL_FRAMES=90  # Keep line-side memory N frames after track drops (occlusion). 0 = purge each frame
#
# Optional: fail fast at startup if DEVICE targets GPU but CUDA is unavailable.
# ML_REQUIRE_INFERENCE_GPU=1
#
# ONNX Runtime (ReID ONNX, semantic search, etc.): tensorrt_first | cuda_first | cuda_only | cpu_only
# ONNX_EXECUTION_PROVIDERS_ORDER=tensorrt_first
# Optional: require a GPU EP for ONNX sessions (set when you deploy GPU-only).
# ML_REQUIRE_ONNX_GPU=1
#
# InsightFace / face stack (defaults follow DEVICE when numeric cuda:N not set):
# FACE_DEVICE=0
#
# ── NVIDIA Jetson (Nano-class + YOLO engine + ONNX) ─────────────────────────
#
# This repo’s Dockerfile targets L4T JetPack 6 (dustynv/l4t-pytorch:r36.4) — e.g. Jetson Orin Nano,
# Orin NX, AGX Orin. Original Jetson Nano (Maxwell, 4GB) needs a JetPack-matched PyTorch/ORT image;
# use the same env names when running uvicorn natively on the board.
#
# YOLO (FrameBus / Ultralytics): .pt (PyTorch) or export TensorRT for less GPU work per frame:
#   yolo export model=models/yolov8n.pt format=engine device=0 half=True imgsz=640
# Then:  YOLO_MODEL=models/yolov8n.engine
# On 4GB boards prefer yolov8n (or smaller); keep WIDTH/HEIGHT modest (see docker-compose defaults).
#
# ONNX Runtime (ReID ONNX, semantic search, etc.):
# - tensorrt_first = max throughput when TensorrtExecutionProvider is stable (default in code).
# - cuda_first = try CUDA EP before TRT (often better on Jetson when TRT EP misbehaves or OOMs).
# - cpu_only = CPU EP only (good for DEVICE=cpu / CI; used by tools/run_crossline_local_video.py on CPU).
ONNX_EXECUTION_PROVIDERS_ORDER=cuda_first
# TensorRT engine cache (writable path; Compose maps this to a volume when using docker-compose.yml).
ONNX_TENSORRT_CACHE_PATH=/app/trt_cache
# Lower workspace on 4GB Jetson so YOLO + ORT share VRAM (bytes). Default in code is 2GB.
ONNX_TENSORRT_MAX_WORKSPACE=536870912
# FP16 TensorRT engines on Jetson (recommended when half=True export matches).
ONNX_TENSORRT_FP16=1
#
# Person search ReID: prefer ONNX on Jetson (GPU EPs via utils/onnx_runtime.py).
# REID_MODEL_ONNX=models/osnet_x1_0.onnx  # ONNX export of OSNet — used by PersonSearchService + EmbeddingWorker
# REID_MODEL_PATH=models/osnet_x1_0.pt    # TorchScript fallback if REID_MODEL_ONNX is unset
#
# Embedding crop quality gates (frame_bus.py _save_best_crops):
# EMBED_MIN_SHARPNESS=15.0    # Laplacian variance threshold — set to 0 to disable blur rejection
#
# RTSP hardware decode (GStreamer nvv4l2decoder or FFmpeg hevc_v4l2m2m) — see RTSP_* below.
# If the board is not detected inside Docker, force: RTSP_ENABLE_GPU_DECODE=true
#
# ── Qdrant (person search / ReID) ───────────────────────────────────────────
# Local dev (Qdrant on host or port-forward): http://127.0.0.1:6333
# Docker Compose overrides this in docker-compose.yml with http://qdrant:6333
# QDRANT_URL=http://127.0.0.1:6333
#
# Semantic search needs a valid ONNX export (not an empty file). Populate models/ via
# `python tools/download_models.py` or copy image_encoder.onnx / text_encoder.onnx from your model bundle.
#
# ── Frame ingest ──────────────────────────────────────────────────────────────
# RTSP ingest order (see stream.py): auto | gstreamer | ffmpeg | opencv
RTSP_BACKEND=auto
# On Jetson, try GStreamer + nvv4l2decoder before Adaptive FFmpeg (requires OpenCV built with GStreamer).
RTSP_GSTREAMER=true
# Frame ingest backend: opencv (default) | pyav | av
# Set to "pyav" or "av" to use PyAV-based ingest (media_pts_ingest_enabled=True).
# Requires the "av" package: pip install av
# STREAM_INGEST=opencv
# Live Redis JPEG: opencv (default, fast boxes) | ultralytics (plot) | none
LIVE_ANNOTATION_MODE=opencv
# Draw bounding boxes whenever YOLO finds targets (even without SAVE_OUTPUT / off-pub frames).
# Default true so person boxes appear without Redis; set false on CPU-tight edge nodes.
LIVE_PREVIEW_ANNOTATE=true
# Task queue frame JPEG quality (1–100); live Redis uses LIVE_JPEG_QUALITY
TASK_QUEUE_JPEG_QUALITY=85
LIVE_JPEG_QUALITY=85
# Disk frame saves (FrameBus OUTPUT_DIR): jpg | webp; quality via SAVE_JPEG_QUALITY / SAVE_WEBP_QUALITY
SAVE_FORMAT=jpg
SAVE_JPEG_QUALITY=80
# FrameBus: SAVE_OUTPUT=false by default (set true only for debug dumps)
# SAVE_OUTPUT=false
#
# ── Test / QA: MP4 with same on-screen annotations as live WebSocket (BGR before JPEG encode) ──
# Off by default — do not enable in production (disk I/O + CPU). Uses the same `annotated` frame as Redis.
# SAVE_ANNOTATED_VIDEO=false
# SAVE_ANNOTATED_VIDEO_PATH=./artifacts/my_run/annotated_stream.mp4
# SAVE_ANNOTATED_VIDEO_FPS=0
# SAVE_ANNOTATED_VIDEO_CODEC=mp4v
# When true, only append frames that would be published to Redis (matches viewer cadence). If Redis is
# down, every processed frame is still written so offline tests get a full video.
# SAVE_ANNOTATED_VIDEO_MATCH_WS=false
# TTL cleanup for outputs + evidence (0 = disable sweeper)
OUTPUT_RETENTION_HOURS=24
STORAGE_CLEANUP_INTERVAL_SEC=3600
# Throttle Manager IPC: push shared_state every N frames and/or STATE_UPDATE_MIN_SEC
STATE_UPDATE_INTERVAL=10
STATE_UPDATE_MIN_SEC=1.0
PERF_LOG_INTERVAL=300
ANNOTATION_DEBUG_LOG_INTERVAL=1
# Optional: route shared_logger file output (default ./logger/app.log relative to process cwd).
# LOG_APP_FILE=/var/log/ml-server/app.log

# Jetson / L4T: enable hardware decode for Adaptive FFmpeg (stream_adapter).
# Use `true` if `auto` skips HW because Jetson was not detected inside the container.
RTSP_ENABLE_GPU_DECODE=auto

# Optional: per-codec ffmpeg decoder names (`ffmpeg -decoders`). Examples on some Jetson images:
# RTSP_JETSON_HEVC_DECODER=hevc_nvmpi
# RTSP_JETSON_H264_DECODER=h264_nvmpi
# Legacy fallback when per-codec vars are unset (same decoder used for probed codec — set carefully):
# RTSP_HWDECODER=hevc_nvmpi

# Hikvision-style substream (often H.264, lower resolution) reduces CPU load if main stream is 4K HEVC:
# POST /cameras with URL like .../Streaming/channels/102 or .../h264/ch1/sub/av_stream

# Stability guard: after this many consecutive Adaptive FFmpeg reconnect cycles,
# stream.py falls back to OpenCV RTSP capture for the current camera process.
RTSP_ADAPTIVE_FAILOVER_AFTER=4

# ── RTSP transport ────────────────────────────────────────────────────────────
# Global default RTSP transport for OpenCV-FFmpeg capture: tcp | udp | udp_multicast
# Per-camera overrides can be set at runtime via utils.rtsp_ffmpeg.set_rtsp_transport(cam_id, transport).
# Clearing per-camera overrides: utils.rtsp_ffmpeg.clear_rtsp_transport_overrides()
RTSP_TRANSPORT=tcp

# ── RTSP / HEVC decode resilience ─────────────────────────────────────────────
# Drop frames that the container flags as corrupt (default true).
# RTSP_DISCARD_CORRUPT=true
#
# Adaptive FFmpeg (stream_adapter.AdaptiveStream) defaults: low_delay, max_delay 500ms,
# reorder_queue_size 0, probesize 32KB. Override via RTSP_MAX_DELAY_US, RTSP_REORDER_QUEUE_SIZE,
# RTSP_ANALYZEDURATION_US, RTSP_PROBESIZE (microseconds / bytes as in ffmpeg).
# Override the full stable FFmpeg extra options string (pipe-separated key;value pairs) for OpenCV path:
# Default: fflags;+genpts+discardcorrupt|max_delay;3000000|reorder_queue_size;1024|err_detect;ignore_err
# err_detect;ignore_err keeps the decoder alive through malformed HEVC NAL units
#   (cu_qp_delta out of range, Non-matching NAL types, Could not find ref with POC).
# RTSP_FFMPEG_EXTRA_OPTIONS=fflags;+genpts+discardcorrupt|max_delay;3000000|reorder_queue_size;1024|err_detect;ignore_err
#
# OpenCV RTSP buffer size (frames): larger helps HEVC / B-frame streams, uses more memory.
# RTSP_OPENCV_BUFFER_SIZE=3
#
# Read/open timeouts (ms). RTSP_READ_TIMEOUT_MSEC=0 disables the read timeout.
# RTSP_OPEN_TIMEOUT_MSEC=15000
# RTSP_READ_TIMEOUT_MSEC=0

# ── WebSocket / Redis live stream ──────────────────────────────────────────────
# Base reconnect delay (ms) when the Redis pub/sub connection drops; doubles on each retry
# up to WS_REDIS_RECONNECT_MAX_MS with ±20% jitter (exponential back-off).
# WS_REDIS_RECONNECT_DELAY_MS=1000
# WS_REDIS_RECONNECT_MAX_MS=30000
# WS_REDIS_MAX_RETRIES=5
# WS_SEND_TIMEOUT_MS=50
# Max frames per second sent to each WebSocket client (per connection); 0 = unlimited.
# WS_MAX_FPS=15
# Optional 4-byte little-endian seq prefix before each JPEG (gap detection); default off.
# WS_INCLUDE_SEQ_HEADER=false

# ── Worker process lifecycle ───────────────────────────────────────────────────
# FrameBus processes that exit naturally (e.g. local video exhausted) are automatically
# reaped (joined) by DetectionResource._reap_finished_processes() on the next start/stop
# call, preventing OS zombies.  The watchdog respawns channels on unexpected crashes.
# WATCHDOG_ENABLED=false
# WATCHDOG_RESPAWN_WINDOW_SEC=600
# WATCHDOG_MAX_RESPAWNS=5
